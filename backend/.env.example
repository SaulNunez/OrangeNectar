# Reddit API credentials (https://www.reddit.com/prefs/apps) - register a "web app"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Must exactly match the redirect URI configured on the Reddit app above
REDDIT_REDIRECT_URI=http://localhost:8000/auth/callback

# Signs the short-lived cookie used during the login redirect (CSRF state
# marker only - the Reddit token itself is stored in Redis, not this cookie).
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=

# Defaults to localhost for local dev; docker-compose overrides this to point at the redis container.
REDIS_URL=redis://localhost:6379/0
